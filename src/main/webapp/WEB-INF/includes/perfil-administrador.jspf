<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="java.util.List,br.com.acta.model.AdministradorGeral,br.com.acta.dao.AdministradorGeralDAO" %>
<%!
    private String h(Object valor) {
        if (valor == null) return "";
        return valor.toString().replace("&", "&amp;").replace("<", "&lt;")
                .replace(">", "&gt;").replace("\"", "&quot;").replace("'", "&#39;");
    }
    private String imagemOtimizada(String url, int tamanho) {
        if (url == null || url.isBlank()) return "";
        return url.replace("/image/upload/", "/image/upload/c_fill,w_" + tamanho + ",h_" + tamanho + ",q_auto,f_auto/");
    }
%>
<%
AdministradorGeral administrador = (AdministradorGeral) session.getAttribute("usuarioLogado");
if (administrador == null) {
    response.sendRedirect(request.getContextPath() + "/autenticacao/login.jsp");
    return;
}
boolean perfilSeparado = Boolean.TRUE.equals(request.getAttribute("perfilSeparado"));
String nome = administrador.getNome() == null ? "" : administrador.getNome();
String email = administrador.getEmail() == null ? "" : administrador.getEmail();
String telefone = administrador.getTelefone() == null ? "" : administrador.getTelefone();
String imagem = administrador.getImagem() == null ? "" : administrador.getImagem();
String imagemPerfil = imagem.isBlank() ? request.getContextPath() + "/assets/images/foto_perfil.svg" : imagemOtimizada(imagem, 512);
List<String> empresasVinculadas;
try {
    empresasVinculadas = new AdministradorGeralDAO().buscarEmpresasAtivas(administrador.getAdm_geral_id());
} catch (br.com.acta.excecoes.DaoException e) {
    application.log("Erro ao consultar empresas vinculadas ao administrador.", e);
    response.setStatus(500);
    request.setAttribute(jakarta.servlet.RequestDispatcher.ERROR_MESSAGE, "Erro ao consultar as empresas vinculadas.");
    request.setAttribute(jakarta.servlet.RequestDispatcher.ERROR_STATUS_CODE, 500);
    request.getRequestDispatcher("/erro.jsp").forward(request, response);
    return;
}
%>
<%!
private String erroCampo(jakarta.servlet.http.HttpServletRequest req, String campo) {
    Object campos = req.getAttribute("campoErro");
    Object mensagem = req.getAttribute("mensagemErro");
    if (campos == null || mensagem == null || !java.util.Arrays.asList(campos.toString().split(",")).contains(campo)) return "";
    return "<small class=\"campo-erro\" id=\"erro-" + campo + "\" role=\"alert\">" + h(mensagem) + "</small>";
}
%>
<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="csrf-token" content="<%= h(br.com.acta.utils.CsrfToken.getOrCreate(session)) %>"><title>Meu perfil | ACTA</title>
<link rel="icon" href="<%= request.getContextPath() %>/assets/images/logo_compacta.svg" type="image/svg+xml">

<link rel="stylesheet" href="<%= request.getContextPath() %>/assets/css/crud.css">
<link rel="stylesheet" href="<%= request.getContextPath() %>/assets/css/perfil-colaborador.css">
<link rel="stylesheet" href="<%= request.getContextPath() %>/assets/css/perfil-administrador.css">
<link rel="stylesheet" href="<%= request.getContextPath() %>/assets/css/mensagens.css">
<script src="<%= request.getContextPath() %>/assets/js/menu.js" defer></script>
</head><body class="perfil-administrador" data-context-path="<%= request.getContextPath() %>">
<svg xmlns="http://www.w3.org/2000/svg" class="perfil-simbolos" aria-hidden="true"><symbol id="i-building" viewBox="0 0 24 24"><rect x="3" y="9" width="8" height="12"/><rect x="11" y="4" width="10" height="17"/><path d="M6 12h2m-2 3h2m-2 3h2m8-10h2m-2 4h2m-2 4h2M2 21h20"/></symbol><symbol id="i-pin" viewBox="0 0 24 24"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></symbol><symbol id="i-users" viewBox="0 0 24 24"><circle cx="12" cy="7" r="3"/><path d="M5 21v-3a7 7 0 0 1 14 0v3M4 9a3 3 0 0 0 0 6M20 9a3 3 0 0 1 0 6"/></symbol><symbol id="i-folder" viewBox="0 0 24 24"><path d="M3 6h7l2 3h9v11H3z"/></symbol><symbol id="i-checklist" viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="1"/><path d="M9 4V2h6v2m-6 9 2 2 4-4"/></symbol><symbol id="i-cycle" viewBox="0 0 24 24"><path d="M20 8a8 8 0 0 0-14-3L4 7m0-4v4h4M4 16a8 8 0 0 0 14 3l2-2m0 4v-4h-4"/></symbol><symbol id="i-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m7 12 3 3 7-7"/></symbol><symbol id="i-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></symbol><symbol id="i-alert" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v6m0 4v.2"/></symbol><symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 22c0-5 3.5-8 8-8s8 3 8 8"/></symbol><symbol id="i-shield" viewBox="0 0 24 24"><path d="m12 2 9 4v6c0 5-3 8-9 10-6-2-9-5-9-10V6z"/><path d="m8 12 3 3 5-6"/></symbol><symbol id="i-camera" viewBox="0 0 24 24"><path d="M4 7h4l2-3h4l2 3h4v13H4z"/><circle cx="12" cy="13" r="4"/></symbol><symbol id="i-edit" viewBox="0 0 24 24"><path d="m4 16 12-12 4 4L8 20H4zM14 6l4 4"/></symbol><symbol id="i-lock" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="12" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></symbol><symbol id="i-menu" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></symbol></svg>
<div class="sistema"><aside class="sidebar"><a class="sidebar-logo" href="<%= request.getContextPath() %>/index.jsp"><img src="<%= request.getContextPath() %>/assets/images/logo_oficial.svg" alt="ACTA"></a><button class="mobile-menu" aria-label="Abrir menu" aria-expanded="false" id="menuToggle" aria-controls="nav"><svg class="ico"><use href="#i-menu"/></svg></button><% if (perfilSeparado) { %><nav class="menu" id="nav" aria-label="Navegação do perfil administrativo">
<a href="<%= request.getContextPath() %>/index.jsp" class="menu-item"><img src="<%= request.getContextPath() %>/assets/images/icone_voltar.svg" alt=""><span>Início</span></a>
<a href="<%= request.getContextPath() %>/perfil-servlet" class="menu-item" aria-current="page"><img src="<%= request.getContextPath() %>/assets/images/icone_colaborador.svg" alt=""><span>Meu perfil</span></a>
<a href="<%= request.getContextPath() %>/empresa-servlet" class="menu-item"><img src="<%= request.getContextPath() %>/assets/images/icone_empresas.svg" alt=""><span>Área administrativa</span></a>
</nav><% } else { %><nav class="menu" id="nav" aria-label="Navegação administrativa"><a href="<%= request.getContextPath() %>/empresa-servlet" class="menu-item"><img src="<%= request.getContextPath() %>/assets/images/icone_empresas.svg" alt=""><span>Empresas</span></a><a href="<%= request.getContextPath() %>/endereco-servlet" class="menu-item"><img src="<%= request.getContextPath() %>/assets/images/icone_endereco.svg" alt=""><span>Endereço</span></a><a href="<%= request.getContextPath() %>/colaborador-servlet" class="menu-item"><img src="<%= request.getContextPath() %>/assets/images/icone_colaborador.svg" alt=""><span>Colaborador</span></a><a href="<%= request.getContextPath() %>/tarefa-servlet" class="menu-item"><img src="<%= request.getContextPath() %>/assets/images/icone_tarefa.svg" alt=""><span>Tarefa</span></a><a href="<%= request.getContextPath() %>/planoAcao-servlet" class="menu-item"><img src="<%= request.getContextPath() %>/assets/images/icone_plano_de_acao.svg" alt=""><span>Plano de ação</span></a><a href="<%= request.getContextPath() %>/ciclo-servlet" class="menu-item"><img src="<%= request.getContextPath() %>/assets/images/icone_ciclos.svg" alt=""><span>Ciclos</span></a><a href="<%= request.getContextPath() %>/licoes-aprendidas-servlet" class="menu-item"><img src="<%= request.getContextPath() %>/assets/images/icone_licoes_aprendidas.svg" alt=""><span>Lições Aprendidas</span></a><a href="<%= request.getContextPath() %>/meta-servlet" class="menu-item"><img src="<%= request.getContextPath() %>/assets/images/icone_metas.svg" alt=""><span>Metas</span></a><a href="<%= request.getContextPath() %>/problema-servlet" class="menu-item"><img src="<%= request.getContextPath() %>/assets/images/icone_problemas.svg" alt=""><span>Problemas</span></a></nav><% } %><div class="perfil-barra"><a class="perfil-admin" href="<%= request.getContextPath() %><%= perfilSeparado ? "/perfil-servlet" : "/crud/configuracoes.jsp" %>"><div class="perfil-foto"><img src="<%= h(imagemPerfil) %>" alt="Foto da conta"></div><div class="perfil-info"><strong class="perfil-nome"><%= h(nome) %></strong><span class="perfil-email"><%= h(email) %></span></div></a><a href="<%= request.getContextPath() %>/index.jsp" class="botao botao-sair">Voltar</a></div></aside><main class="conteudo perfil-conteudo">
<% Object avisoPerfil = session.getAttribute("perfilSucesso");
if (avisoPerfil == null) avisoPerfil = request.getAttribute("mensagemSucesso");
if (avisoPerfil != null) { session.removeAttribute("perfilSucesso"); %><p class="operacao-sucesso" role="status"><%= h(avisoPerfil) %></p><% } %>
<header class="top"><div><h1>Meu perfil</h1><p class="subtitle">Gerencie suas informações e preferências</p></div><span class="pill"><svg class="ico"><use href="#i-shield"/></svg>Administrador geral</span></header>
<section class="profile-banner"><div class="avatar"><img id="config-foto-preview" src="<%= h(imagemPerfil) %>" alt="Foto de perfil"></div><div class="banner-divider"></div><div class="banner-text"><h2><%= h(nome) %></h2><p>Administrador geral</p><p class="email"><%= h(email) %></p></div>
<form class="perfil-foto-form" method="post" action="<%= request.getContextPath() %>/administrador-geral-servlet"><% if (perfilSeparado) { %><input type="hidden" name="retorno" value="perfil"><% } %>
<input type="hidden" name="csrfToken" value="<%= h(br.com.acta.utils.CsrfToken.getOrCreate(session)) %>">
<input type="hidden" name="acao" value="atualizar"><input type="hidden" name="origem" value="foto"><input type="hidden" name="id-adm-geral" value="<%= administrador.getAdm_geral_id() %>">
<input type="hidden" name="nome" value="<%= h(nome) %>"><input type="hidden" name="email" value="<%= h(email) %>"><input type="hidden" name="telefone" value="<%= h(telefone) %>">
<input type="hidden" id="config-imagem-url" name="imagem" value="<%= h(imagem) %>"><input type="file" id="config-foto-arquivo" accept="image/png,image/jpeg,image/webp" hidden>
<div class="perfil-foto-botoes"><button type="button" class="botao botao-secundario" data-escolher-foto><svg class="ico"><use href="#i-camera"/></svg>Alterar foto</button><button type="submit" class="botao botao-principal" data-salvar-foto disabled>Salvar foto</button></div><p id="config-foto-status" role="status" aria-live="polite"></p>
<% if ("foto".equals(request.getParameter("origem")) && request.getAttribute("mensagemErro") != null) { %><p class="formulario-erro" role="alert"><%= h(request.getAttribute("mensagemErro")) %></p><% } %>
</form></section>
<section class="config-dados perfil-card"><div class="config-dados-topo"><div class="card-title"><svg class="ico"><use href="#i-user"/></svg><h3>Informações pessoais</h3></div><button class="botao botao-principal" data-open="editModal"><svg class="ico"><use href="#i-edit"/></svg>Editar dados</button></div><div class="rule"></div><div class="config-campos">
<div><span class="config-rotulo">Nome completo</span><span class="config-valor" id="displayName"><%= h(nome) %></span></div>
<div><span class="config-rotulo">E-mail</span><span class="config-valor" id="displayEmail"><%= h(email) %></span></div>
<div><span class="config-rotulo">Telefone</span><span class="config-valor" data-formato="telefone"><%= h(telefone) %></span></div>
<div><span class="config-rotulo">Tipo de conta</span><span class="config-valor">Administrador geral</span></div></div></section>
<section class="config-dados perfil-card perfil-seguranca"><div class="config-dados-topo"><div class="card-title"><svg class="ico"><use href="#i-shield"/></svg><div><h3>Segurança da conta</h3><p class="security-text">Gerencie sua senha de acesso ao sistema</p></div></div><button class="botao botao-secundario" data-open="passwordModal"><svg class="ico"><use href="#i-lock"/></svg>Alterar senha</button></div></section>
<section class="config-dados perfil-card"><div class="config-dados-topo"><div class="card-title"><svg class="ico"><use href="#i-building"/></svg><h3>Empresas administradas</h3></div></div>
<% if (empresasVinculadas.isEmpty()) { %><p class="empresa-vazia">Nenhuma empresa ativa vinculada.</p><% } %>
<% for (String empresaNome : empresasVinculadas) { %><span class="company-tag"><%= h(empresaNome) %></span><% } %></section>
<div class="perfil-sair-final"><form method="post" action="<%= request.getContextPath() %>/logout-servlet"><input type="hidden" name="csrfToken" value="<%= h(br.com.acta.utils.CsrfToken.getOrCreate(session)) %>"><button type="submit" class="botao botao-sair">Sair</button></form></div></main></div><dialog class="perfil-dialog" id="editModal" <%= request.getAttribute("mensagemErro") != null && "atualizar".equals(request.getParameter("acao")) && !"foto".equals(request.getParameter("origem")) ? "data-reabrir" : "" %> aria-labelledby="editModalTitle"><form class="formulario" method="post" action="<%= request.getContextPath() %>/administrador-geral-servlet"><% if (perfilSeparado) { %><input type="hidden" name="retorno" value="perfil"><% } %><h3 id="editModalTitle">Editar dados pessoais</h3><input type="hidden" name="csrfToken" value="<%= h(br.com.acta.utils.CsrfToken.getOrCreate(session)) %>"><input type="hidden" name="acao" value="atualizar"><input type="hidden" name="id-adm-geral" value="<%= administrador.getAdm_geral_id() %>"><input type="hidden" name="imagem" value="<%= h(imagem) %>"><% if (request.getAttribute("mensagemErro") != null && request.getAttribute("campoErro") == null) { %><p class="formulario-erro" role="alert"><%= h(request.getAttribute("mensagemErro")) %></p><% } %><div class="campo"><label for="nameInput">Nome completo</label><input id="nameInput" name="nome" type="text" maxlength="50" required value="<%= h(nome) %>"><%= erroCampo(request, "nome") %></div><div class="campo"><label for="emailInput">E-mail</label><input id="emailInput" name="email" type="email" maxlength="80" required value="<%= h(email) %>"><%= erroCampo(request, "email") %></div><div class="campo"><label for="phoneInput">Telefone</label><input id="phoneInput" name="telefone" type="tel" maxlength="15" required value="<%= h(telefone) %>" data-mascara="telefone" inputmode="numeric" pattern="\([0-9]{2}\) [0-9]{4,5}-[0-9]{4}"><%= erroCampo(request, "telefone") %></div><div class="botoes-modal"><button type="button" class="botao botao-secundario" data-close>Cancelar</button><button type="submit" class="botao botao-principal">Salvar alterações</button></div></form></dialog>
<dialog class="perfil-dialog" id="passwordModal" <%= request.getAttribute("mensagemErro") != null && "atualizarSenha".equals(request.getParameter("acao")) && !"foto".equals(request.getParameter("origem")) ? "data-reabrir" : "" %> aria-labelledby="passwordModalTitle"><form class="formulario" method="post" action="<%= request.getContextPath() %>/administrador-geral-servlet"><% if (perfilSeparado) { %><input type="hidden" name="retorno" value="perfil"><% } %><h3 id="passwordModalTitle">Alterar senha</h3><input type="hidden" name="csrfToken" value="<%= h(br.com.acta.utils.CsrfToken.getOrCreate(session)) %>"><input type="hidden" name="acao" value="atualizarSenha"><input type="hidden" name="email" value="<%= h(email) %>"><% if (request.getAttribute("mensagemErro") != null && request.getAttribute("campoErro") == null) { %><p class="formulario-erro" role="alert"><%= h(request.getAttribute("mensagemErro")) %></p><% } %><div class="campo"><label for="currentPassword">Senha atual</label><input id="currentPassword" name="senha_antiga" type="password" maxlength="100" required autocomplete="current-password"><%= erroCampo(request, "senha_antiga") %></div><div class="campo"><label for="newPassword">Nova senha</label><input id="newPassword" name="senha_nova" type="password" maxlength="100" required autocomplete="new-password"><%= erroCampo(request, "senha_nova") %></div><div class="campo"><label for="confirmPassword">Confirmar nova senha</label><input id="confirmPassword" name="senha_confirmar" type="password" maxlength="100" required autocomplete="new-password"><%= erroCampo(request, "senha_confirmar") %></div><div class="botoes-modal"><button type="button" class="botao botao-secundario" data-close>Cancelar</button><button type="submit" class="botao botao-principal">Confirmar</button></div></form></dialog>
<script src="<%= request.getContextPath() %>/assets/js/regex.js"></script><script src="<%= request.getContextPath() %>/assets/js/perfil-colaborador.js"></script><script src="<%= request.getContextPath() %>/assets/js/cloudinary-profile.js"></script><script src="<%= request.getContextPath() %>/assets/js/mensagens.js"></script></body></html>
