<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="br.com.acta.model.Colaborador,br.com.acta.utils.CsrfToken" %>
<%! private String h(Object valor) { return valor == null ? "" : valor.toString().replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;").replace("'", "&#39;"); } %>
<% Colaborador col = (Colaborador) request.getAttribute("colaborador");
if (col == null) { response.sendRedirect(request.getContextPath() + "/perfil-servlet"); return; }
String fotoPerfil = request.getContextPath() + "/assets/images/foto_perfil.svg";
if (col.getImagem() != null && col.getImagem().startsWith("https://res.cloudinary.com/")) fotoPerfil = col.getImagem();
String nomeCompleto = col.getNome() + " " + col.getSobrenome(); %>
<%!
private String erroCampo(jakarta.servlet.http.HttpServletRequest req, String campo) {
    Object campos = req.getAttribute("campoErro");
    Object mensagem = req.getAttribute("mensagemErro");
    if (campos == null || mensagem == null || !java.util.Arrays.asList(campos.toString().split(",")).contains(campo)) return "";
    return "<small class=\"campo-erro\" id=\"erro-" + campo + "\" role=\"alert\">" + h(mensagem) + "</small>";
}
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta name="csrf-token" content="<%= h(CsrfToken.getOrCreate(session)) %>">
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Meu perfil | ACTA</title>
<link rel="stylesheet" href="<%= request.getContextPath() %>/assets/css/crud.css">
<link rel="stylesheet" href="<%= request.getContextPath() %>/assets/css/perfil-colaborador.css">
<link rel="icon" href="<%= request.getContextPath() %>/assets/images/logo_compacta.svg" type="image/svg+xml">

<link rel="stylesheet" href="<%= request.getContextPath() %>/assets/css/mensagens.css">
<script src="<%= request.getContextPath() %>/assets/js/menu.js" defer></script>
</head>
<body data-context-path="<%= request.getContextPath() %>">
<svg xmlns="http://www.w3.org/2000/svg" class="perfil-simbolos" aria-hidden="true"><symbol id="i-building" viewBox="0 0 24 24"><rect x="3" y="9" width="8" height="12"/><rect x="11" y="4" width="10" height="17"/><path d="M6 12h2m-2 3h2m-2 3h2m8-10h2m-2 4h2m-2 4h2M2 21h20"/></symbol><symbol id="i-pin" viewBox="0 0 24 24"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></symbol><symbol id="i-users" viewBox="0 0 24 24"><circle cx="12" cy="7" r="3"/><path d="M5 21v-3a7 7 0 0 1 14 0v3M4 9a3 3 0 0 0 0 6M20 9a3 3 0 0 1 0 6"/></symbol><symbol id="i-folder" viewBox="0 0 24 24"><path d="M3 6h7l2 3h9v11H3z"/></symbol><symbol id="i-checklist" viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="1"/><path d="M9 4V2h6v2m-6 9 2 2 4-4"/></symbol><symbol id="i-cycle" viewBox="0 0 24 24"><path d="M20 8a8 8 0 0 0-14-3L4 7m0-4v4h4M4 16a8 8 0 0 0 14 3l2-2m0 4v-4h-4"/></symbol><symbol id="i-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m7 12 3 3 7-7"/></symbol><symbol id="i-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></symbol><symbol id="i-alert" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v6m0 4v.2"/></symbol><symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 22c0-5 3.5-8 8-8s8 3 8 8"/></symbol><symbol id="i-shield" viewBox="0 0 24 24"><path d="m12 2 9 4v6c0 5-3 8-9 10-6-2-9-5-9-10V6z"/><path d="m8 12 3 3 5-6"/></symbol><symbol id="i-camera" viewBox="0 0 24 24"><path d="M4 7h4l2-3h4l2 3h4v13H4z"/><circle cx="12" cy="13" r="4"/></symbol><symbol id="i-edit" viewBox="0 0 24 24"><path d="m4 16 12-12 4 4L8 20H4zM14 6l4 4"/></symbol><symbol id="i-lock" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="12" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></symbol><symbol id="i-menu" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></symbol></svg>
<div class="sistema"><aside class="sidebar"><a href="<%= request.getContextPath() %>/index.jsp" class="sidebar-logo"><img src="<%= request.getContextPath() %>/assets/images/logo_oficial.svg" alt="ACTA"></a><button class="mobile-menu" aria-label="Abrir menu" aria-expanded="false" id="menuToggle" aria-controls="nav"><svg class="ico"><use href="#i-menu"/></svg></button><nav class="menu" id="nav" aria-label="Navegação do colaborador"><a href="<%= request.getContextPath() %>/index.jsp" class="menu-item"><img src="<%= request.getContextPath() %>/assets/images/icone_voltar.svg" alt=""><span>Início</span></a><a href="<%= request.getContextPath() %>/perfil-servlet" class="menu-item" aria-current="page"><img src="<%= request.getContextPath() %>/assets/images/icone_colaborador.svg" alt=""><span>Meu perfil</span></a><a href="<%= request.getContextPath() %>/minha-empresa-servlet" class="menu-item"><img src="<%= request.getContextPath() %>/assets/images/icone_empresas.svg" alt=""><span>Ver empresa</span></a></nav><div class="perfil-barra"><a class="perfil-admin" href="<%= request.getContextPath() %>/perfil-servlet"><div class="perfil-foto"><img src="<%= h(fotoPerfil) %>" alt="Foto da conta"></div><div class="perfil-info"><strong class="perfil-nome" id="sideName"><%= h(nomeCompleto) %></strong><span class="perfil-email" id="sideEmail"><%= h(col.getEmail()) %></span></div></a><a href="<%= request.getContextPath() %>/index.jsp" class="botao botao-sair">Voltar</a></div></aside>
<main class="conteudo perfil-conteudo"><% if (request.getAttribute("mensagemErro") != null && request.getAttribute("campoErro") == null && request.getParameter("acao") == null) { %><p class="perfil-aviso" role="alert"><%= h(request.getAttribute("mensagemErro")) %></p><% } %><% if (request.getAttribute("mensagemSucesso") != null) { %><p class="operacao-sucesso" role="status"><%= h(request.getAttribute("mensagemSucesso")) %></p><% } %><header class="top"><div><h1>Meu perfil</h1><p class="subtitle">Consulte e atualize suas informações pessoais</p></div><span class="pill"><svg class="ico"><use href="#i-user"/></svg>Colaborador</span></header>
<section class="profile-banner"><div class="avatar" id="avatar"><img id="config-foto-preview" src="<%= h(fotoPerfil) %>" alt="Foto de perfil"></div><div class="banner-divider"></div><div class="banner-text"><h2 id="bannerName"><%= h(nomeCompleto) %></h2><p>Colaborador</p><p class="email" id="bannerEmail"><%= h(col.getEmail()) %></p></div><form class="perfil-foto-form" method="post" action="<%= request.getContextPath() %>/perfil-servlet">
<input type="hidden" name="csrfToken" value="<%= h(CsrfToken.getOrCreate(session)) %>">
<input type="hidden" name="acao" value="alterarFoto">
<input type="hidden" id="config-imagem-url" name="imagem" value="<%= h(col.getImagem()) %>">
<input type="file" id="config-foto-arquivo" accept="image/png,image/jpeg,image/webp" hidden>
<div class="perfil-foto-botoes"><button type="button" class="botao botao-secundario" data-escolher-foto><svg class="ico"><use href="#i-camera"/></svg>Alterar foto</button><button type="submit" class="botao botao-principal" data-salvar-foto disabled>Salvar foto</button></div>
<p id="config-foto-status" role="status" aria-live="polite"></p><%= erroCampo(request, "imagem") %>
<% if ("alterarFoto".equals(request.getParameter("acao")) && request.getAttribute("mensagemErro") != null && request.getAttribute("campoErro") == null) { %><p class="formulario-erro" role="alert"><%= h(request.getAttribute("mensagemErro")) %></p><% } %>
</form></section>
<section class="config-dados perfil-card"><div class="config-dados-topo"><div class="card-title"><svg class="ico"><use href="#i-user"/></svg><h3>Informações pessoais</h3></div><button class="botao botao-principal" data-open="editModal"><svg class="ico"><use href="#i-edit"/></svg>Editar dados</button></div><div class="rule"></div><div class="config-campos">
<div><span class="config-rotulo">Nome completo</span><span class="config-valor" id="displayName"><%= h(nomeCompleto) %></span></div>
<div><span class="config-rotulo">E-mail</span><span class="config-valor" id="displayEmail"><%= h(col.getEmail()) %></span></div>
<div><span class="config-rotulo">Telefone</span><span class="config-valor" id="displayPhone" data-formato="telefone"><%= h(col.getTelefone()) %></span></div>
<div><span class="config-rotulo">CPF</span><span class="config-valor" data-formato="cpf"><%= h(col.getCpf()) %></span></div>
<div><span class="config-rotulo">Área</span><span class="config-valor"><%= h(col.getArea()) %></span></div>
<div><span class="config-rotulo">Cargo</span><span class="config-valor"><%= h(col.getCargo()) %></span></div>
<div><span class="config-rotulo">Data de contratação</span><span class="config-valor"><%= h(col.getDt_contratacao() == null ? "" : new java.text.SimpleDateFormat("dd/MM/yyyy").format(col.getDt_contratacao())) %></span></div>
<div><span class="config-rotulo">Status</span><span class="status-tag">Ativa</span></div>
</div></section>
<section class="config-dados perfil-card perfil-seguranca"><div class="config-dados-topo"><div class="card-title"><svg class="ico"><use href="#i-shield"/></svg><div><h3>Segurança da conta</h3><p class="security-text">Gerencie sua senha de acesso ao sistema</p></div></div><button class="botao botao-secundario" data-open="passwordModal"><svg class="ico"><use href="#i-lock"/></svg>Alterar senha</button></div></section>
<section class="config-dados perfil-card" id="empresa-vinculada"><div class="config-dados-topo"><div class="card-title"><svg class="ico"><use href="#i-building"/></svg><h3>Empresa vinculada</h3></div></div><a class="company-tag" href="<%= request.getContextPath() %>/minha-empresa-servlet"><%= h(col.getNome_empresa()) %> <span aria-hidden="true" class="perfil-seta">↗</span></a></section>
<div class="perfil-sair-final"><button type="button" class="botao botao-sair" data-open="logoutModal">Sair</button></div><%@ include file="/WEB-INF/includes/confirmar-saida.jspf" %>
</main></div>
<dialog class="perfil-dialog" id="editModal" <%= request.getAttribute("mensagemErro") != null && "atualizar".equals(request.getParameter("acao")) ? "data-reabrir" : "" %> aria-labelledby="editTitle"><form class="formulario" id="editForm" method="post" action="<%= request.getContextPath() %>/perfil-servlet"><input type="hidden" name="acao" value="atualizar"><input type="hidden" name="csrfToken" value="<%= h(CsrfToken.getOrCreate(session)) %>"><h3 id="editTitle">Editar dados pessoais</h3><% if (request.getAttribute("mensagemErro") != null && request.getAttribute("campoErro") == null) { %><p class="formulario-erro" role="alert"><%= h(request.getAttribute("mensagemErro")) %></p><% } %><div class="campo"><label for="nameInput">Nome</label><input id="nameInput" value="<%= h(col.getNome()) %>" name="nome" required maxlength="50"><%= erroCampo(request, "nome") %></div><div class="campo"><label for="surnameInput">Sobrenome</label><input id="surnameInput" value="<%= h(col.getSobrenome()) %>" name="sobrenome" required maxlength="50"><%= erroCampo(request, "sobrenome") %></div><div class="campo"><label for="emailInput">E-mail</label><input id="emailInput" value="<%= h(col.getEmail()) %>" name="email" type="email" required maxlength="80"><%= erroCampo(request, "email") %></div><div class="campo"><label for="phoneInput">Telefone</label><input id="phoneInput" value="<%= h(col.getTelefone()) %>" name="telefone" type="tel" data-mascara="telefone" inputmode="numeric" required maxlength="15" pattern="\([0-9]{2}\) [0-9]{4,5}-[0-9]{4}" placeholder="(11) 99999-9999"><%= erroCampo(request, "telefone") %></div><div class="botoes-modal"><button type="button" class="botao botao-secundario" data-close>Cancelar</button><button type="submit" class="botao botao-secundario botao-principal">Salvar alterações</button></div></form></dialog>
<dialog class="perfil-dialog" id="passwordModal" <%= request.getAttribute("mensagemErro") != null && "alterarSenha".equals(request.getParameter("acao")) ? "data-reabrir" : "" %> aria-labelledby="passwordTitle"><form class="formulario" id="passwordForm" method="post" action="<%= request.getContextPath() %>/perfil-servlet"><input type="hidden" name="acao" value="alterarSenha"><input type="hidden" name="csrfToken" value="<%= h(CsrfToken.getOrCreate(session)) %>"><h3 id="passwordTitle">Alterar senha</h3><% if (request.getAttribute("mensagemErro") != null && request.getAttribute("campoErro") == null) { %><p class="formulario-erro" role="alert"><%= h(request.getAttribute("mensagemErro")) %></p><% } %><div class="campo"><label for="currentPassword">Senha atual</label><input id="currentPassword" name="senhaAtual" type="password" maxlength="100" required autocomplete="current-password"><%= erroCampo(request, "senhaAtual") %></div><div class="campo"><label for="newPassword">Nova senha</label><input id="newPassword" name="senhaNova" type="password" maxlength="100" required minlength="8" autocomplete="new-password"><%= erroCampo(request, "senhaNova") %></div><div class="campo"><label for="confirmPassword">Confirmar nova senha</label><input id="confirmPassword" name="confirmacaoSenha" type="password" maxlength="100" required minlength="8" autocomplete="new-password"><%= erroCampo(request, "confirmacaoSenha") %></div><div class="botoes-modal"><button type="button" class="botao botao-secundario" data-close>Cancelar</button><button type="submit" class="botao botao-secundario botao-principal">Confirmar</button></div></form></dialog><p class="perfil-retorno" id="toast" role="status" hidden></p>
<script src="<%= request.getContextPath() %>/assets/js/regex.js"></script>
<script src="<%= request.getContextPath() %>/assets/js/perfil-colaborador.js"></script>
<script src="<%= request.getContextPath() %>/assets/js/mensagens.js"></script>
<script src="<%= request.getContextPath() %>/assets/js/cloudinary-profile.js"></script>
</body></html>
