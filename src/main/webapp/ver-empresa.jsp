<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="java.util.List,br.com.acta.model.Colaborador,br.com.acta.model.Empresa,br.com.acta.model.Endereco,br.com.acta.utils.CsrfToken" %>
<%! private String h(Object valor) { return valor == null ? "" : valor.toString().replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;").replace("'", "&#39;"); } %>
<% Colaborador col = (Colaborador) request.getAttribute("colaborador");
if (col == null) { response.sendRedirect(request.getContextPath() + "/minha-empresa-servlet"); return; }
Empresa empresa = (Empresa) request.getAttribute("empresa");
List<Endereco> enderecos = (List<Endereco>) request.getAttribute("enderecos");
if (enderecos == null) enderecos = java.util.List.of();
String nomeCompleto = col.getNome() + " " + col.getSobrenome();
String fotoPerfil = col.getImagem() != null && col.getImagem().startsWith("https://res.cloudinary.com/") ? col.getImagem() : request.getContextPath() + "/assets/images/foto_perfil.svg";
String porte = empresa == null || empresa.getTamanho() == null ? "Não informado" : switch (empresa.getTamanho()) { case PEQUENA -> "Pequena"; case MEDIA -> "Média"; case GRANDE -> "Grande"; };
%>
<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ver empresa | ACTA</title>
<link rel="stylesheet" href="<%= request.getContextPath() %>/assets/css/crud.css">
<link rel="stylesheet" href="<%= request.getContextPath() %>/assets/css/perfil-colaborador.css">
<link rel="stylesheet" href="<%= request.getContextPath() %>/assets/css/ver-empresa.css">
<link rel="stylesheet" href="<%= request.getContextPath() %>/assets/css/mensagens.css">
<link rel="icon" href="<%= request.getContextPath() %>/assets/images/logo_compacta.svg" type="image/svg+xml">
<script src="<%= request.getContextPath() %>/assets/js/menu.js" defer></script>
</head><body>
<svg xmlns="http://www.w3.org/2000/svg" class="perfil-simbolos" aria-hidden="true"><symbol id="i-building" viewBox="0 0 24 24"><rect x="3" y="9" width="8" height="12"/><rect x="11" y="4" width="10" height="17"/><path d="M6 12h2m-2 3h2m-2 3h2m8-10h2m-2 4h2m-2 4h2M2 21h20"/></symbol><symbol id="i-pin" viewBox="0 0 24 24"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></symbol><symbol id="i-users" viewBox="0 0 24 24"><circle cx="12" cy="7" r="3"/><path d="M5 21v-3a7 7 0 0 1 14 0v3M4 9a3 3 0 0 0 0 6M20 9a3 3 0 0 1 0 6"/></symbol><symbol id="i-folder" viewBox="0 0 24 24"><path d="M3 6h7l2 3h9v11H3z"/></symbol><symbol id="i-checklist" viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="1"/><path d="M9 4V2h6v2m-6 9 2 2 4-4"/></symbol><symbol id="i-cycle" viewBox="0 0 24 24"><path d="M20 8a8 8 0 0 0-14-3L4 7m0-4v4h4M4 16a8 8 0 0 0 14 3l2-2m0 4v-4h-4"/></symbol><symbol id="i-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m7 12 3 3 7-7"/></symbol><symbol id="i-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></symbol><symbol id="i-alert" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v6m0 4v.2"/></symbol><symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 22c0-5 3.5-8 8-8s8 3 8 8"/></symbol><symbol id="i-shield" viewBox="0 0 24 24"><path d="m12 2 9 4v6c0 5-3 8-9 10-6-2-9-5-9-10V6z"/><path d="m8 12 3 3 5-6"/></symbol><symbol id="i-camera" viewBox="0 0 24 24"><path d="M4 7h4l2-3h4l2 3h4v13H4z"/><circle cx="12" cy="13" r="4"/></symbol><symbol id="i-edit" viewBox="0 0 24 24"><path d="m4 16 12-12 4 4L8 20H4zM14 6l4 4"/></symbol><symbol id="i-lock" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="12" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></symbol><symbol id="i-menu" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></symbol></svg>
<div class="sistema"><aside class="sidebar"><a href="<%= request.getContextPath() %>/index.jsp" class="sidebar-logo"><img src="<%= request.getContextPath() %>/assets/images/logo_oficial.svg" alt="ACTA"></a><button class="mobile-menu" aria-label="Abrir menu" aria-expanded="false" id="menuToggle" aria-controls="nav"><svg class="ico"><use href="#i-menu"/></svg></button><nav class="menu" id="nav" aria-label="Navegação do colaborador"><a href="<%= request.getContextPath() %>/index.jsp" class="menu-item"><img src="<%= request.getContextPath() %>/assets/images/icone_voltar.svg" alt=""><span>Início</span></a><a href="<%= request.getContextPath() %>/perfil-servlet" class="menu-item"><img src="<%= request.getContextPath() %>/assets/images/icone_colaborador.svg" alt=""><span>Meu perfil</span></a><a href="<%= request.getContextPath() %>/minha-empresa-servlet" class="menu-item" aria-current="page"><img src="<%= request.getContextPath() %>/assets/images/icone_empresas.svg" alt=""><span>Ver empresa</span></a></nav><div class="perfil-barra"><a class="perfil-admin" href="<%= request.getContextPath() %>/perfil-servlet"><div class="perfil-foto"><img src="<%= h(fotoPerfil) %>" alt="Foto da conta"></div><div class="perfil-info"><strong class="perfil-nome" id="sideName"><%= h(nomeCompleto) %></strong><span class="perfil-email" id="sideEmail"><%= h(col.getEmail()) %></span></div></a><a href="<%= request.getContextPath() %>/index.jsp" class="botao botao-sair">Voltar</a></div></aside>
<main class="conteudo perfil-conteudo empresa-conteudo"><a class="back-link" href="<%= request.getContextPath() %>/perfil-servlet">← Voltar ao perfil</a><header class="top"><div><h1>Ver empresa</h1><p class="subtitle">Conheça as informações da empresa à qual você está vinculado</p></div><span class="pill"><svg class="ico"><use href="#i-building"/></svg>Minha empresa</span></header>
<% if (empresa != null && request.getAttribute("empresaErro") == null) { %><section class="company-hero"><div class="company-logo"><svg class="ico"><use href="#i-building"/></svg></div><div class="hero-info"><h2><%= h(empresa.getNome()) %></h2><p>Informações cadastrais da organização</p><div class="hero-tags"><span class="tag"><%= h(empresa.getSetor()) %></span><span class="tag"><%= h(porte) %></span><span class="status-tag"><%= h(empresa.getStatus() == br.com.acta.enums.Status.ATIVA ? "Ativa" : "Inativa") %></span></div></div></section>
<section class="config-dados perfil-card"><div class="config-dados-topo"><div class="card-title"><svg class="ico"><use href="#i-building"/></svg><h3>Informações da empresa</h3></div><span class="view-only">Somente visualização</span></div><div class="rule"></div><div class="data-grid"><div><span class="field-label">Nome</span><span class="field-value"><%= h(empresa.getNome()) %></span></div><div><span class="field-label">CNPJ</span><span class="field-value" data-formato="cnpj"><%= h(empresa.getCnpj()) %></span></div><div><span class="field-label">Setor</span><span class="field-value"><%= h(empresa.getSetor()) %></span></div><div><span class="field-label">Tamanho</span><span class="field-value"><%= h(porte) %></span></div><div><span class="field-label">Status</span><span class="status-tag"><%= h(empresa.getStatus() == br.com.acta.enums.Status.ATIVA ? "Ativa" : "Inativa") %></span></div></div></section>
<% if (enderecos.isEmpty()) { %><p class="empresa-sem-endereco">Nenhum endereço cadastrado para esta empresa.</p><% } %>
<% for (Endereco endereco : enderecos) { %><section class="config-dados perfil-card"><div class="config-dados-topo"><div class="card-title"><svg class="ico"><use href="#i-pin"/></svg><h3>Endereço — <%= h(endereco.getUnidade()) %></h3></div></div><div class="rule"></div><div class="data-grid"><div><span class="field-label">Rua</span><span class="field-value"><%= h(endereco.getRua()) %></span></div><div><span class="field-label">Número</span><span class="field-value"><%= h(endereco.getNumero()) %></span></div><div><span class="field-label">Bairro</span><span class="field-value"><%= h(endereco.getBairro()) %></span></div><div><span class="field-label">Cidade</span><span class="field-value"><%= h(endereco.getCidade()) %></span></div><div><span class="field-label">Estado</span><span class="field-value"><%= h(endereco.getEstado()) %></span></div><div><span class="field-label">CEP</span><span class="field-value" data-formato="cep"><%= h(endereco.getCep()) %></span></div><div><span class="field-label">Complemento</span><span class="field-value"><%= h(endereco.getComplemento()) %></span></div><div><span class="field-label">Unidade</span><span class="field-value"><%= h(endereco.getUnidade()) %></span></div></div></section><% } %>
<% } else { %><p class="formulario-erro" role="alert"><%= h(request.getAttribute("empresaErro") == null ? "Empresa indisponível." : request.getAttribute("empresaErro")) %></p><% } %></main></div><script src="<%= request.getContextPath() %>/assets/js/regex.js"></script><script src="<%= request.getContextPath() %>/assets/js/perfil-colaborador.js"></script></body></html>
